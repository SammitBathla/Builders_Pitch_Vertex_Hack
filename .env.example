# --- Active LLM provider: Anthropic Claude API (default; see README "LLM provider") ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5

# --- Alternative provider: Amazon Bedrock (original Assumption A6 plan) ---
# Only used if you switch backend/services/investigation.py and friends back to
# backend/llm/bedrock_client.py — unused by default. Populate via standard boto3
# credential chain instead if you prefer (aws configure / ~/.aws/credentials / instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Assumption A4: manual review minutes per case, used only for the time-saved metric
MANUAL_MINUTES_PER_CASE=17

# Dataset generation seed (Requirement 1: reproducibility)
DATASET_SEED=42
DATASET_SIZE=1000

DATA_DIR=./data
