# AWS credentials for Bedrock (Requirement A6: Nova Lite, ap-south-1)
# Populate via standard boto3 credential chain instead if you prefer
# (aws configure / ~/.aws/credentials / instance role) — these are optional overrides.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Assumption A4: manual review minutes per case, used only for the time-saved metric
MANUAL_MINUTES_PER_CASE=17

# Dataset generation seed (Requirement 1: reproducibility)
DATASET_SEED=42
DATASET_SIZE=1000

DATA_DIR=./data
